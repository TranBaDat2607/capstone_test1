GEMINI_API_KEY="your_api_key_here"
# REQUIRED. Get a key at https://aistudio.google.com/apikey. Gemini is the default LLM
# provider for every LLM stage, including the mandatory-LLM step 6
# (src/esg_kg/crosscheck/claims_vs_conduct.py) and step 5d
# (src/esg_kg/resolve/align_claims.py). See CLAUDE.md for the provider history; step 6
# also has an opt-in DeepSeek and OpenAI alternative (below).

# Chat model id for every Gemini LLM stage (extract, extract_triples, fix_triples,
# entities, align_claims, claims_vs_conduct) — src/esg_kg/core/llm.py's DEFAULT_MODEL
# reads this ONE variable, so changing the model everywhere means editing this line
# only, no code edit needed. Uncomment to override; default when unset/commented is
# gemini-2.5-flash-lite. A stage's own --model CLI flag still overrides this.
# GEMINI_MODEL="gemini-2.5-flash-lite"

# --- OPTIONAL: DeepSeek V4 Flash -------------------------------------------------
# A SWAPPABLE ALTERNATIVE to Gemini for align_claims (step 5d) and claims_vs_conduct
# (step 6) only — those two stages talk to the LLM through a provider-agnostic
# interface (src/esg_kg/core/llm.py). extract/extract_triples/fix_triples/entities stay
# Gemini-only (Gemini-specific context caching, no DeepSeek equivalent) regardless of
# what you set here. Skip this whole section if you're happy running on Gemini alone.
#
# Setup steps to actually use it:
#   1. Get a key at https://platform.deepseek.com/api_keys, put it in DEEPSEEK_API_KEY
#      below (uncomment both lines).
#   2. Choose the provider PER RUN, either way works, no code edit needed:
#        - one-off:  python src/run.py align_claims --provider deepseek ...
#                    python src/run.py claims_vs_conduct --provider-order deepseek ...
#        - or set LLM_PROVIDER=deepseek below to make it the default for both stages
#          whenever their --provider/--provider-order flag is omitted.
#   3. Leave DEEPSEEK_MODEL commented out unless DeepSeek renames/retires
#      "deepseek-v4-flash" — the default already matches that.
# DEEPSEEK_API_KEY=""
# DEEPSEEK_MODEL="deepseek-v4-flash"
# LLM_PROVIDER="gemini"

# --- OPTIONAL: OpenAI (ChatGPT) --------------------------------------------------
# A SWAPPABLE ALTERNATIVE to Gemini for claims_vs_conduct (step 6) ONLY — re-added
# 2026-08-06. Unlike DeepSeek above, this is NOT wired into align_claims (their
# --provider flag still only accepts gemini/deepseek), so it only ever affects step 6.
#
# Setup steps to actually use it:
#   1. Get a key at https://platform.openai.com/api-keys, put it in OPENAI_API_KEY
#      below (uncomment both lines).
#   2. Choose it PER RUN: python src/run.py claims_vs_conduct --provider-order openai ...
#      (no LLM_PROVIDER env switch for this one — that variable only covers
#      align_claims/claims_vs_conduct's shared gemini/deepseek factory; step 6's
#      own --provider-order flag is how you pick openai).
#   3. Leave OPENAI_MODEL commented out unless you want a different chat model —
#      the default already matches "gpt-4o-mini".
# OPENAI_API_KEY=""
# OPENAI_MODEL="gpt-4o-mini"

# Hugging Face token for the team data snapshot (src/esg_kg/core/datasync.py). A READ token is enough
# to `pull`; only the maintainer pushing a new snapshot needs a WRITE token. Alternative to
# setting it here: `hf auth login`.
HF_TOKEN=""

# Neo4j target for src/esg_kg/load/neo4j_load.py (step 5). Defaults match a dedicated
# Community instance; override here to change connection without editing code.
NEO4J_URI="bolt://localhost:8687"
NEO4J_USER="greenwashing"
# Local dev only. docker-compose.yml reads this same variable, so whatever you set here is
# what the container is created with. Pick your own; never commit a real one.
NEO4J_PASSWORD="changeme"
# Enterprise/Desktop only — the named database created by neo4j/init.cypher. On plain
# Community leave this unset (single default `neo4j` db) and use NEO4J_USER="neo4j".
NEO4J_DATABASE="greenwashingkg"
