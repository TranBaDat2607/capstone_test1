GEMINI_API_KEY="your_api_key_here"

# Optional fallback LLM provider for step 6 (src/step07_crosscheck_claims_vs_conduct.py).
# Used only if Gemini is unavailable (e.g. billing/quota); leave unset to skip it.
OPENAI_API_KEY=""

# Hugging Face token for the team data snapshot (src/data_sync.py). A READ token is enough
# to `pull`; only the maintainer pushing a new snapshot needs a WRITE token. Alternative to
# setting it here: `hf auth login`.
HF_TOKEN=""

# Neo4j target for src/step06_load_graph_to_neo4j.py (step 5). Defaults match a dedicated
# Community instance; override here to change connection without editing code.
NEO4J_URI="bolt://localhost:8687"
NEO4J_USER="greenwashing"
NEO4J_PASSWORD="nammovuivui"
# Enterprise/Desktop only — the named database created by neo4j/init.cypher. On plain
# Community leave this unset (single default `neo4j` db) and use NEO4J_USER="neo4j".
NEO4J_DATABASE="greenwashingkg"
