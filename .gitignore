# ---- Secrets ----
.env
.env.*
!.env.example

# ---- Read-only external reference (NOT part of this project; see CLAUDE.md) ----
# EmeraldMind/ is an external reference implementation with its own .git repo, a
# ~50 MB graph_latest.json, and its own .env secrets. It must never be uploaded.
# It was previously committed as a phantom submodule (a bare gitlink with no
# .gitmodules); that entry has been removed with `git rm --cached EmeraldMind`.
EmeraldMind/

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.ipynb_checkpoints/

# ---- Generated pipeline data & outputs ----
# config/ (schema.json, issuer_registry.json, company list) is intentionally
# tracked; only generated artifacts are ignored.
#   raw -> interim -> labeled -> outputs all live under data/
# These are distributed to the team via the Hugging Face dataset repo instead —
# see README "Onboarding" and `python src/esg_kg/core/datasync.py pull`. The pinned dataset
# revision lives in data_version.json, which IS tracked.
data/
graph_output/
kpi_output/
esg_news_output/
test_data/

# Resume/progress metadata written by upload_large_folder in src/esg_kg/core/datasync.py push.
.cache/

# ---- IDE / OS ----
.idea/
.vscode/
.DS_Store
Thumbs.db

# ---- Personal / document artifacts ----
capstone_document.tex
ef5b9835-91e3-4571-a0e8-c389650690e1-meca.md
articles.json

# ---- Neo4j (docker-compose data volume, step 5) ----
# Never distributed: it is a live DB volume (corrupt if copied while running) and is
# pinned to the Neo4j image version. Teammates rebuild it with step06 from
# graph_output/resolved/resolved_graph.json instead.
neo4j_data/

# ---- Local HF dataset clone (manual, not via data_sync.py) ----
# capstone/ is a hand-cloned checkout of the HF dataset repo
# (nammovuivui-capstone/capstone) with its own .git — same phantom-
# submodule risk as EmeraldMind/. data_sync.py pull/push writes
# data/, graph_output/, kpi_output/ directly into REPO_ROOT instead;
# this folder is redundant with that flow.
capstone/
